{
    "version": 1.0,
    "case": {
        "mesh_file": "mesh/alm.nmsh",
        "output_directory": "output",
        "output_boundary": false,
        "output_checkpoints": false,
        "output_at_end": true,
        "time": {
            "end_time": 5.0,
            "timestep": 1.25e-2,
            "variable_timestep": false,
            "target_cfl": 0.4
        },
        "numerics": {
            "time_order": 3,
            "polynomial_order": 5,
            "dealias": false
        },
        "adjoint_fluid": {
            "initial_condition": {
                "type": "uniform",
                "value": [ 0.0, 0.0, 0.0 ]
            },
            "boundary_conditions": [
                {
                    "type": "velocity_value",
                    "zone_indices": [ 1 ],
		            "value": [ 0.0, 0.0, 0.0 ]
                },
                {
                    "type": "outflow",
                    "zone_indices": [ 2 ]
                }
            ]
        },
        "fluid": {
            "scheme": "pnpn",
            "Re": 1e3,
            "gamma": 1.4,
            "initial_condition": {
                "type": "uniform",
                "value": [ 1.0, 0.0, 0.0 ]
            }, 
            "velocity_solver": {
                "type": "coupled_cg",
                "preconditioner": {
                    "type": "jacobi"
                },
                "projection_space_size": 0,
                "absolute_tolerance": 1e-7,
                "max_iterations": 800
            },
            "pressure_solver": {
                "type": "gmres",
                "preconditioner": {
                    "type": "hsmg"
                },
                "projection_space_size": 8,
                "absolute_tolerance": 1e-7,
                "max_iterations": 800
            },
            "boundary_conditions": [
                {
                    "type": "velocity_value",
                    "zone_indices": [ 1 ],
		            "value": [ 1.0, 0.0, 0.0 ]
                },
                {
                    "type": "outflow",
                    "zone_indices": [ 2 ]
                }
            ],
	        "output_control": "simulationtime",
            "output_value": 1000.0
        }
    },
    "optimization": {
        "design": {
            "type": "actuator_line",
            "N": 4,
            "b": 3.0,
            "eps": 0.375,
            "xcenter": 0.0,
            "ycenter": 0.0,
            "zcenter": 0.0,
            "gamma": [0.1, 0.1, 0.1, 0.1]
        },
        "solver": {
            "type": "mma",
            "max_iterations": 10,
            "tolerance": 1.0e-7,
            "mma": {
                "asyinit": 0.1,
                "asyincr": 1.05,
                "asydecr": 0.65,
                "move_limit": 0.1
            }
        },
        "objectives": [
            {
                "type": "drag_lift_deviation",
                "weight": 1.0,
                "lift_penalty_weight": 2.0,
                "L_target": 0.1
            }
        ]
    }
}
